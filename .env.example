# Copie para .env.local e preencha com as chaves do projeto Supabase.
# Settings > API Keys no painel do Supabase.
#
# Vite só expõe ao frontend variáveis com o prefixo VITE_.
# Se você copiou do painel no formato NEXT_PUBLIC_*, renomeie.
#
# NUNCA coloque aqui a service_role / secret key — apenas a publishable key,
# que é pública por natureza e depende da RLS para proteger os dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
